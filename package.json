{
  "name": "cobblemon-realms-launcher",
  "version": "1.0.0",
  "description": "Launcher dedicado y autónomo para el modpack Cobblemon Realms (Minecraft 1.21.1 / NeoForge)",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:electron": "tsc && vite build && electron-builder",
    "build:exe": "tsc && vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.cobblemonrealms.launcher",
    "productName": "Cobblemon Realms",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cobblemon Realms"
    }
  },
  "dependencies": {
    "@xmcl/client": "3.2.0",
    "@xmcl/core": "^2.16.3",
    "@xmcl/installer": "^6.3.7",
    "@xmcl/server-info": "^2.0.4",
    "@xmcl/user": "^4.4.2",
    "adm-zip": "^0.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2",
    "@xmcl/yauzl": "2.10.0",
    "@xmcl/bytebuffer": "0.1.1",
    "@xmcl/nbt": "3.0.2",
    "@xmcl/text-component": "2.1.3"
  }
}
